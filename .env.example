# Hugging Face API Key (Server-side only - for Vercel deployment)
# Get your free API key at: https://huggingface.co/settings/tokens
# This is used by the serverless function in /api/generate-description.ts
# For local development, this is optional (AI features will use fallback)
HF_API_KEY=your_huggingface_api_key_here

# Supabase Configuration (Required for multi-user features)
# Create a free account at: https://supabase.com
# Get these values from your Supabase project settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
